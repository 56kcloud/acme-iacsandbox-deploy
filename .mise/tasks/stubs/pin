#!/usr/bin/env bash
#MISE description="Pin one env's deploy-<env>.yml to a shared-repo commit"
#USAGE arg "<env>" help="Environment directory, e.g. engorg"
#USAGE arg "<sha>" help="Full 40-character commit SHA in the shared repo"
#USAGE arg "<version>" help="Version comment, e.g. v0.1.0"
# Pins one env's deploy stub to a commit of the shared workflows repo, keeping
# the version as a comment. Envs are pinned one at a time so upgrades can roll
# from one env to the next.
#
# Usage: mise run stubs:pin <env> <sha> <version>
# Example: mise run stubs:pin engorg 6856b2d1b4d5ee611f24bf37a80be72029d7fa37 v0.1.1
set -euo pipefail

ENV_DIR="${usage_env:?}"
SHA="${usage_sha:?}"
VERSION="${usage_version:?}"
SHARED_REPO="56kcloud/acme-iacplatform-githubworkflows"
STUB="${MISE_PROJECT_ROOT}/.github/workflows/deploy-${ENV_DIR}.yml"

if [[ ! "${SHA}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "ERROR — '${SHA}' is not a 40-character commit SHA."
  exit 1
fi

if [[ ! -f "${STUB}" ]]; then
  echo "ERROR — no ${STUB}; is '${ENV_DIR}' an env directory?"
  exit 1
fi

# Stops here (set -e) if the commit doesn't exist in the shared repo.
gh api "repos/${SHARED_REPO}/commits/${SHA}" --jq .sha > /dev/null

# -i.bak works with both BSD (macOS) and GNU sed.
sed -E -i.bak "s#^([[:space:]]*uses:[[:space:]]*${SHARED_REPO}/[^@]+)@[^[:space:]]+.*#\1@${SHA} \# ${VERSION}#" "${STUB}"
rm "${STUB}.bak"

grep -E "uses:[[:space:]]*${SHARED_REPO}/" "${STUB}"
echo ""
echo "OK — pinned deploy-${ENV_DIR}.yml to ${VERSION}. Now run: mise run config:sync ${ENV_DIR}"
