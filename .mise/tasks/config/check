#!/usr/bin/env bash
#MISE description="Check an env dir's vendored configs match the SHA its stubs pin"
#USAGE arg "<env>" help="Environment directory, e.g. engorg"
# Fails if the env directory's vendored configs differ from configs/deploy at
# the version the env's deploy stub pins. CI runs the same check.
#
# Usage: mise run config:check <env>
# Example: mise run config:check engorg
set -euo pipefail

exec "${MISE_PROJECT_ROOT}/.mise/config-run.sh" check "${usage_env:?}"
