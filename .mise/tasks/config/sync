#!/usr/bin/env bash
#MISE description="Vendor shared configs into an env dir at the SHA its stubs pin"
#USAGE arg "<env>" help="Environment directory, e.g. engorg"
# Writes configs/deploy from the shared repo into the env directory, at the
# version the env's deploy stub pins.
#
# Usage: mise run config:sync <env>
# Example: mise run config:sync engorg
set -euo pipefail

exec "${MISE_PROJECT_ROOT}/.mise/config-run.sh" sync "${usage_env:?}"
